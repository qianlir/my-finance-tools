.page {
  padding: 12px 16px 68px;
}

/* 通用 */
.mono { font-family: 'Menlo', 'SF Mono', monospace; }
.bold { font-weight: 600; }

/* 状态栏 */
.status-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 4px 0 6px;
}

.freshness {
  font-size: 10px;
  color: rgba(26,22,19,0.4);
}

.status-right {
  display: flex;
  align-items: center;
  gap: 8px;
}

.time {
  font-family: 'Menlo', 'SF Mono', monospace;
  font-size: 10px;
  color: rgba(26,22,19,0.4);
}

.version {
  font-family: 'Menlo', 'SF Mono', monospace;
  font-size: 9px;
  color: rgba(26,22,19,0.2);
}

/* 期货 */
.futures {
  margin-bottom: 12px;
}

.futures-row {
  font-size: 12px;
  line-height: 22px;
}

.futures-date {
  font-size: 11px;
  color: rgba(26,22,19,0.6);
  margin-right: 6px;
}

.dot {
  color: rgba(26,22,19,0.2);
}

/* 指数 Tab */
.idx-tabs {
  margin-bottom: 12px;
  white-space: nowrap;
}

.idx-tabs-inner {
  display: inline-flex;
  gap: 6px;
}

.idx-tab {
  font-size: 11px;
  padding: 3px 10px;
  border-radius: 999px;
  border: 1px solid rgba(26,22,19,0.2);
  color: rgba(26,22,19,0.8);
  white-space: nowrap;
  display: inline-block;
}

.idx-tab.active {
  background: #1A1613;
  color: #F5EFE4;
  border-color: #1A1613;
}

/* 修正提示 */
.correction-hint {
  font-size: 10px;
  color: rgba(26,22,19,0.4);
  margin-bottom: 12px;
  padding: 6px 10px;
  background: rgba(26,22,19,0.05);
  border-radius: 2px;
}

/* ETF 卡片 */
.etf-card {
  padding: 12px 0;
  border-top: 1px solid rgba(26,22,19,0.1);
}

.etf-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
}

.etf-left {
  flex: 1;
}

.etf-name {
  font-size: 14px;
  font-weight: 500;
  color: #1A1613;
  display: block;
}

.etf-code {
  font-size: 10px;
  color: rgba(26,22,19,0.4);
  margin-top: 1px;
  display: block;
}

.etf-right {
  text-align: right;
  flex-shrink: 0;
}

.etf-price {
  font-size: 15px;
  display: block;
}

.etf-change {
  font-size: 12px;
  display: block;
}

/* 快速指标 */
.etf-stats {
  display: flex;
  gap: 12px;
  margin-top: 8px;
  flex-wrap: wrap;
}

.stat {
  font-size: 10px;
  color: rgba(26,22,19,0.6);
}

.stat-label {
  margin-right: 2px;
}

.stat-value {
  font-size: 11px;
}

/* 展开详情 */
.etf-detail {
  margin-top: 12px;
  padding: 12px;
  background: rgba(26,22,19,0.05);
  border-radius: 2px;
}

.detail-row {
  display: flex;
  justify-content: space-between;
  padding: 4px 0;
  border-bottom: 1px solid rgba(26,22,19,0.1);
}

.detail-label {
  font-size: 10px;
  color: rgba(26,22,19,0.6);
}

.detail-value {
  font-size: 11px;
  color: #1A1613;
}

/* 底部说明 */
.footer-note {
  font-size: 10px;
  color: rgba(26,22,19,0.4);
  line-height: 1.6;
  margin-top: 12px;
  padding: 0 4px;
}

.disclaimer {
  text-align: center;
  padding: 12px 0;
  font-size: 10px;
  color: rgba(26,22,19,0.3);
}

/* 状态页 */
.loading, .error {
  display: flex;
  justify-content: center;
  align-items: center;
  height: 400px;
  font-size: 14px;
}

.loading {
  color: rgba(26,22,19,0.4);
}

.error {
  color: #A8342A;
}
