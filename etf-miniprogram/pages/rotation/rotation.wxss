.page {
  padding: 12px 16px 68px;
}

.mono { font-family: 'Menlo', 'SF Mono', monospace; }
.red { color: #A8342A; }
.green { color: #2A6B4F; }

/* 副标题 */
.subtitle {
  font-size: 11px;
  color: rgba(26,22,19,0.4);
  margin-bottom: 16px;
}

/* 当前持仓 */
.current {
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 10px 12px;
  border-left: 3px solid #1A1613;
  background: rgba(26,22,19,0.05);
  border-radius: 0 2px 2px 0;
  margin-bottom: 16px;
}

.current-label {
  font-size: 10px;
  color: rgba(26,22,19,0.4);
  text-transform: uppercase;
  letter-spacing: 0.08em;
}

.current-name {
  font-size: 14px;
  font-weight: 500;
  color: #1A1613;
}

.current-code {
  font-size: 10px;
  color: rgba(26,22,19,0.4);
}

/* 指标卡片 */
.metrics {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 8px;
  margin-bottom: 12px;
}

.metric-card {
  background: rgba(245,240,230,1);
  border: 1px solid rgba(26,22,19,0.08);
  border-radius: 2px;
  padding: 12px;
}

.metric-card.highlight {
  background: rgba(168,52,42,0.04);
  border-color: rgba(168,52,42,0.15);
}

.metric-label {
  display: block;
  font-size: 9px;
  color: rgba(26,22,19,0.4);
  text-transform: uppercase;
  letter-spacing: 0.08em;
  margin-bottom: 4px;
}

.metric-value {
  display: block;
  font-size: 20px;
  font-weight: 600;
  color: #1A1613;
}

/* 走势图 */
.chart-wrap {
  margin-bottom: 12px;
  background: rgba(26,22,19,0.03);
  border-radius: 2px;
  padding: 10px 8px 4px;
}

.chart-legend {
  display: flex;
  gap: 14px;
  margin-bottom: 6px;
  padding-left: 4px;
}

.legend-item {
  display: flex;
  align-items: center;
  gap: 4px;
  font-size: 10px;
  color: rgba(26,22,19,0.4);
}

.legend-dot {
  width: 8px;
  height: 3px;
  border-radius: 1px;
}

.dot-red { background: #A8342A; }
.dot-green { background: #2A6B4F; }
.dot-gold { background: #8b6914; }

.chart-canvas {
  width: 100%;
  height: 180px;
}

/* 市值对比 */
.values-bar {
  display: flex;
  justify-content: space-between;
  padding: 8px 0;
  border-top: 1px solid rgba(26,22,19,0.1);
  border-bottom: 1px solid rgba(26,22,19,0.1);
  margin-bottom: 20px;
}

.vb-item {
  text-align: center;
}

.vb-label {
  display: block;
  font-size: 9px;
  color: rgba(26,22,19,0.4);
  text-transform: uppercase;
  letter-spacing: 0.06em;
}

.vb-value {
  display: block;
  font-size: 12px;
  color: #1A1613;
  margin-top: 2px;
}

/* Section label */
.section-label {
  font-size: 10px;
  color: rgba(26,22,19,0.4);
  text-transform: uppercase;
  letter-spacing: 0.08em;
  margin-bottom: 8px;
}

/* 操作记录 */
.trade {
  padding: 10px 0;
  border-top: 1px solid rgba(26,22,19,0.1);
}

.trade-head {
  display: flex;
  align-items: center;
  gap: 8px;
  margin-bottom: 6px;
}

.trade-seq {
  font-size: 11px;
  color: rgba(26,22,19,0.3);
  width: 24px;
}

.trade-date {
  font-size: 12px;
  color: #1A1613;
  flex: 1;
}

.trade-action {
  font-size: 10px;
  padding: 1px 8px;
  border-radius: 2px;
  font-weight: 600;
  letter-spacing: 0.04em;
}

.act-init {
  background: rgba(42,107,79,0.1);
  color: #2A6B4F;
}

.act-swap {
  background: rgba(168,52,42,0.08);
  color: #A8342A;
}

/* Trade body */
.trade-body {
  padding-left: 32px;
}

.tb-row {
  display: flex;
  align-items: center;
  gap: 6px;
  padding: 2px 0;
  font-size: 12px;
}

.tb-label {
  font-size: 10px;
  color: rgba(26,22,19,0.6);
  width: 16px;
  flex-shrink: 0;
}

.tb-value {
  flex: 1;
  font-size: 12px;
  color: #1A1613;
}

.tb-score {
  font-size: 11px;
  color: rgba(26,22,19,0.4);
  flex-shrink: 0;
}

.tb-diff {
  font-size: 10px;
  color: rgba(26,22,19,0.4);
  margin-top: 2px;
}

/* Trade footer */
.trade-foot {
  display: flex;
  justify-content: space-between;
  padding-left: 32px;
  margin-top: 4px;
}

.tf-val {
  font-size: 11px;
  color: rgba(26,22,19,0.6);
}

.tf-lead {
  font-size: 11px;
  font-weight: 600;
}

/* Divider */
.divider {
  border-top: 1px solid rgba(26,22,19,0.1);
  margin-top: 4px;
}

/* 免责 */
.disclaimer {
  text-align: center;
  padding: 12px 0;
  font-size: 10px;
  color: rgba(26,22,19,0.3);
}

/* 锁定 */
.locked {
  display: flex;
  justify-content: center;
  align-items: center;
  height: 400px;
}

.locked-text {
  font-size: 13px;
  color: rgba(26,22,19,0.3);
}

/* 状态页 */
.loading, .error {
  display: flex;
  justify-content: center;
  align-items: center;
  height: 400px;
  font-size: 14px;
}

.loading {
  color: rgba(26,22,19,0.4);
}

.error {
  color: #A8342A;
}
