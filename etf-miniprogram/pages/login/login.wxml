<view class="page">
  <view class="form">
    <view class="label">设备ID（点击复制）</view>
    <view class="user-box" bindtap="onCopyUser">
      <text class="user-text">{{user}}</text>
    </view>
    <view class="input-wrap">
      <input class="input" placeholder="密码" password="{{!showPass}}" value="{{pass}}" bindinput="onPassInput" />
      <text class="eye-icon" bindtap="onTogglePass">{{showPass ? '🙈' : '👁️'}}</text>
    </view>
    <text wx:if="{{err}}" class="err">{{err}}</text>
    <view class="btn" bindtap="onSubmit">确认</view>
  </view>
</view>
