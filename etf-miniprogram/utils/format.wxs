var formatPercent = function(value) {
  if (value === null || value === undefined) return '—'
  var sign = value > 0 ? '+' : ''
  return sign + value.toFixed(2) + '%'
}

var formatPrice = function(value) {
  if (value === null || value === undefined) return '—'
  return value.toFixed(3)
}

var formatInt = function(value) {
  if (value === null || value === undefined) return '—'
  return '' + Math.round(value)
}

var formatMoney = function(value) {
  if (value === null || value === undefined) return '—'
  return value.toFixed(2)
}

var formatScore = function(value) {
  if (value === null || value === undefined) return '—'
  return value.toFixed(2)
}

var shortDate = function(value) {
  if (!value) return '—'
  return value.slice(5)
}

var navPremium = function(price, nav) {
  if (!price || !nav || nav === 0) return 0
  return (price / nav - 1) * 100
}

var colorClass = function(value) {
  if (value > 0) return 'red'
  if (value < 0) return 'green'
  return 'neutral'
}

var excessWithAvg = function(excess, avg) {
  var e = formatPercent(excess)
  var a = formatPercent(avg)
  return e + '(' + a + ')'
}

module.exports = {
  navPremium: navPremium,
  shortDate: shortDate,
  formatPercent: formatPercent,
  formatPrice: formatPrice,
  formatInt: formatInt,
  formatMoney: formatMoney,
  formatScore: formatScore,
  colorClass: colorClass,
  excessWithAvg: excessWithAvg
}
